{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoneNote",
  "version": "1.13.0",
  "identifier": "com.noty.windows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NoneNote",
        "width": 960,
        "height": 640,
        "resizable": true
      },
      {
        "label": "edge",
        "title": "NoneNote Edge",
        "url": "edge.html",
        "width": 44,
        "height": 480,
        "x": 0,
        "y": 120,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
